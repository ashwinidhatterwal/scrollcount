{
  "name": "scrollcount-friends",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "observability": {"enabled": false},
  "d1_databases": [{"binding":"DB","database_name":"scrollcount-friends","database_id":"REPLACE_WITH_D1_ID"}],
  "ratelimits": [{"name":"RATE_LIMITER","namespace_id":"16001","simple":{"limit":60,"period":60}}],
  "triggers": {"crons":["*/10 * * * *"]}
}
